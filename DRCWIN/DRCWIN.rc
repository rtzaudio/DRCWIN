    ID_VIEW_SHOWFRAMENUMBER "Show or hide the time code frame number display\nToggle Frame Number Display"
    ID_GENERATOR_EDITTIME   "Edit the current SMPTE start time values\nEdit SMPTE Time"
    ID_GENERATOR_RESUME     "Resume the SMPTE generator\nResume Stripe"
    ID_GENERATOR_STOP       "Stop the SMPTE generator\nStop Stripe"
    ID_GENERATOR_START      "Start the SMPTE generator\nStart Stripe"
    ID_TRANSPORT_PUNCH      "Punch in or out while in play mode\nPunch"
END

